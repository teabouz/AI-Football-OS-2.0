# --- Telegram ---
# Get this from @BotFather on Telegram (create a bot with /newbot)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- AI (Claude) ---
# Get this from console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5

# --- Database ---
# SQLite is fine for Phase 1 / early testing. Swap for Postgres later, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_football
DATABASE_URL=sqlite:///./ai_football.db

# --- Admin (Telegram) ---
# Comma-separated Telegram numeric user IDs allowed to use /admin in the bot.
# Get your own ID by messaging @userinfobot on Telegram.
ADMIN_TELEGRAM_IDS=123456789

# --- Admin Web Dashboard ---
ADMIN_DASHBOARD_USERNAME=admin
ADMIN_DASHBOARD_PASSWORD=changeme

# --- Subscription ---
FREE_TIER_DAILY_QUESTIONS=5
PREMIUM_MONTHLY_PRICE_NGN=5,000

# --- Payments (Paystack) ---
# Get this from your Paystack dashboard -> Settings -> API Keys & Webhooks
# Use a test secret key (sk_test_...) while developing.
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PREMIUM_PRICE_KOBO=500000
PREMIUM_DURATION_DAYS=30

# Public URL where payment_server.py (port 5001) is reachable (Paystack needs
# to be able to reach this for the webhook + redirect callback). While
# testing locally, tunnel port 5001 (e.g. `ngrok http 5001`, or an SSH
# tunnel -- see README) and paste the https URL it gives you here, e.g.:
# PUBLIC_BASE_URL=https://abcd1234.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:5001

# --- Coach Dashboard (Phase 3) ---
# Random secret for signing dashboard login sessions. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-value
DASHBOARD_TOKEN_TTL_MINUTES=15

# Public URL where coach_dashboard.py (port 5002) is reachable. This is a
# SEPARATE variable from PUBLIC_BASE_URL above -- the payment server (5001)
# and the coach dashboard (5002) are two different processes and, when
# tunnelled, get two different public URLs. /dashboard in the bot uses this
# to build the "Open Coach Dashboard" link.
#
# http://127.0.0.1:5002 is fine ONLY for opening the dashboard yourself in a
# browser on this same computer. It will NOT work when tapped from Telegram
# on a phone -- Telegram can't reach your machine's localhost. For that,
# tunnel port 5002 (e.g. `ngrok http 5002`, or an SSH tunnel via
# localhost.run / serveo.net / pinggy.io -- see README) and paste the https
# URL it gives you here, e.g.:
# DASHBOARD_BASE_URL=https://wxyz5678.ngrok-free.app
DASHBOARD_BASE_URL=http://127.0.0.1:5002

# --- Video Analysis (Phase 4) ---
# Requires the ffmpeg + ffprobe binaries on PATH (system package, not pip) —
# e.g. `sudo apt install ffmpeg` on Ubuntu/Debian, `brew install ffmpeg` on macOS.
MAX_VIDEO_MB=20
VIDEO_FRAME_COUNT=6
# Only needed if ffmpeg/ffprobe aren't on PATH, or you want a non-default temp dir:
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# VIDEO_TEMP_DIR=/tmp/ai_football_video
